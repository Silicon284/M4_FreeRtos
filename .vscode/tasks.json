{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "type": "shell",
            "label": "Build FreeRTOS",
            "command": "make",
            "args": ["all"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Clean FreeRTOS",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CubeProg: Flash FreeRTOS",
            "command": "STM32_Programmer_CLI",
            "args": [
                "--connect",
                "port=swd",
                "--download",
                "${workspaceFolder}/FreeRTOS.elf",
                "-hardRst",
                "-rst",
                "--start"
            ],
            "options": {
                "cwd": "C:\\ST\\STM32CubeCLT_1.18.0\\STM32CubeProgrammer\\bin"
            },
            "problemMatcher": []
        },
        {
            "label": "Build + Flash FreeRTOS",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build FreeRTOS",
                "CubeProg: Flash FreeRTOS"
            ]
        },
        {
            "type": "shell",
            "label": "Start GDB Server for FreeRTOS",
            "command": "ST-LINK_gdbserver.exe",
            "args": [
                "-p",
                "61235",
                "-l",
                "1",
                "-d",
                "-cp",
                "C:\\ST\\STM32CubeCLT_1.18.0\\STM32CubeProgrammer\\bin"
            ],
            "options": {
                "cwd": "C:\\ST\\STM32CubeCLT_1.18.0\\STLink-gdb-server\\bin"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CubeProg: List all available communication interfaces",
            "command": "STM32_Programmer_CLI",
            "args": ["--list"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
