{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FreeRTOS - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${workspaceFolder}/FreeRTOS.elf",
            "request": "launch",        
            "servertype": "stlink",
            "device": "STM32H745ZITx", //MCU used
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",
            "svdFile": "C:/ST/STM32CubeCLT_1.18.0/STMicroelectronics_CMSIS_SVD/STM32H745_CM4.svd",
            "serverpath": "C:/ST/STM32CubeCLT_1.18.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "stm32cubeprogrammer":"C:/ST/STM32CubeCLT_1.18.0/STM32CubeProgrammer/bin",
            "stlinkPath": "C:/ST/STM32CubeCLT_1.18.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",   
            "armToolchainPath": "C:/ST/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin",
            "gdbPath":"C:/ST/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "v1": false,
            "serverArgs": [
                "-t", "-s", 
                "-k"
            ],
            "preLaunchTask": "Build + Flash FreeRTOS"
        },
        {
            "name": "Attach FreeRTOS - ST-Link",
            "cwd": "${workspaceFolder}",    
            "type": "cortex-debug",
            "executable": "${workspaceFolder}/FreeRTOS_CortexM4_qemu/port/FreeRTOS.elf",
            "request": "attach", 
            "servertype": "stlink",
            "device": "STM32H745ZITx", //MCU used
            "interface": "swd",
            "serialNumber": "",
            "svdFile": "C:/ST/STM32CubeCLT_1.18.0/STMicroelectronics_CMSIS_SVD/STM32H745_CM4.svd",
            "serverpath": "C:/ST/STM32CubeCLT_1.18.0/STLink-gdb-server/bin",
            "stm32cubeprogrammer":"C:/ST/STM32CubeCLT_1.18.0/STM32CubeProgrammer/bin",
            "stlinkPath": "C:/ST/STM32CubeCLT_1.18.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",   
            "armToolchainPath": "C:/ST/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin",
            "gdbPath":"C:/ST/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "v1": false,
            "serverArgs": [
                "-t", "-s"
            ],
        },
                
        {
            "name": "cppdbg: Attach to QEMU",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/FreeRTOS_CortexM4_qemu/port/FreeRTOS.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "localhost:1234",
            "setupCommands": [
                { 
                    "description": "Enable pretty-printing for gdb",
                    "text": "set architecture arm",
                    "ignoreFailures": true
                },
                { 
                    "description": "Run Reset Command",
                    "text": "monitor system reset",
                    "ignoreFailures": true
                },
                {
                    "description": "Set hex display format",
                    "text": "set output-radix 16"
                }
            ]
        }        
    ]
}